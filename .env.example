# PuzzleTime Development Environment Variables
# Copy this file to .env and adjust as needed

# Database (defaults match docker-compose.yml)
RAILS_DB_HOST=ptimedb
RAILS_DB_USERNAME=puzzletime
RAILS_DB_PASSWORD=timepuzzle
RAILS_DB_NAME=puzzletime_development

# Cache
RAILS_MEMCACHED_HOST=ptimecache
RAILS_MEMCACHED_PORT=11211

# Authentication - enable database auth for local development
AUTH_DB_ACTIVE=true

# Timezone
RAILS_TIME_ZONE=Europe/Zurich

# Locale (de-CH is default)
# RAILS_LOCALE=de-CH

# Mailer (MailCatcher in development)
RAILS_PTIME_MAILER_FROM=puzzletime@localhost

# Optional: Keycloak SSO (disabled by default)
# AUTH_KEYCLOAK_ACTIVE=false
# AUTH_KEYCLOAK_HOST=
# AUTH_KEYCLOAK_REALM=
# AUTH_KEYCLOAK_CLIENT=
# AUTH_KEYCLOAK_SECRET=

# Optional: LDAP (disabled by default)
# RAILS_LDAP_HOST=
# RAILS_LDAP_PORT=636

# Optional: CRM integrations (disabled by default)
# RAILS_HIGHRISE_URL=
# RAILS_HIGHRISE_TOKEN=
# RAILS_ODOO_API_URL=

# Optional: Invoicing (disabled by default)
# RAILS_SMALL_INVOICE_TOKEN=

# Optional: Error tracking (disabled by default)
# GLITCHTIP_DSN=
# SENTRY_DSN=
