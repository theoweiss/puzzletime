# =============================================================================
# PuzzleTime Production Environment Configuration
# =============================================================================
# Copy this file to .env.prod and fill in the values
# Required values are marked with (required)

# =============================================================================
# Domain & URL
# =============================================================================

# Your domain name (required)
DOMAIN=puzzletime.example.com

# Timezone
TIMEZONE=Europe/Zurich

# =============================================================================
# Database (required)
# =============================================================================

POSTGRES_USER=puzzletime
POSTGRES_PASSWORD=  # (required) Generate with: openssl rand -base64 32
POSTGRES_DB=puzzletime_production

# =============================================================================
# Rails (required)
# =============================================================================

# Generate with: docker run --rm ruby:3.2 ruby -e "require 'securerandom'; puts SecureRandom.hex(64)"
SECRET_KEY_BASE=  # (required)

# Session cookie security (default: true)
# Set to false ONLY for local testing over HTTP (not for production!)
# RAILS_SESSION_SECURE=false

# File storage service (default: ocp4_s3)
# Use 'local' for local testing without S3
# RAILS_STORAGE_SERVICE=local

# =============================================================================
# Email / SMTP
# =============================================================================

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAILER_FROM=puzzletime@example.com

# =============================================================================
# Authentication
# =============================================================================

# Database authentication (simple username/password)
AUTH_DB_ACTIVE=true

# Keycloak / OpenID Connect (optional)
AUTH_KEYCLOAK_ACTIVE=false
AUTH_KEYCLOAK_HOST=
AUTH_KEYCLOAK_REALM=
AUTH_KEYCLOAK_CLIENT=
AUTH_KEYCLOAK_SECRET=

# LDAP / Active Directory (optional)
LDAP_HOST=
LDAP_PORT=636

# =============================================================================
# Reverse Proxy (if using Traefik)
# =============================================================================

# Name of your Traefik docker network (only if using Traefik)
# TRAEFIK_NETWORK=traefik_network

# =============================================================================
# Optional Integrations
# =============================================================================

# CRM - Highrise
# RAILS_HIGHRISE_URL=https://highrisehq.com
# RAILS_HIGHRISE_TOKEN=

# CRM - Odoo
# RAILS_ODOO_API_URL=
# RAILS_ODOO_BASE_URL=
# RAILS_ODOO_DATABASE=
# RAILS_ODOO_USER=
# RAILS_ODOO_PASSWORD=

# Invoicing - SmallInvoice
# RAILS_SMALL_INVOICE_TOKEN=

# Error Tracking - Sentry/Glitchtip
# GLITCHTIP_DSN=
# SENTRY_DSN=

# =============================================================================
# Initial Admin User (optional)
# =============================================================================
# Set these for automated setup, or leave empty for interactive prompt
# during ./bin/setup.sh

ADMIN_FIRSTNAME=
ADMIN_LASTNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
